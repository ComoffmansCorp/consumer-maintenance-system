# Yandex Geosuggest API -- text-only address autocomplete on the marketplace
# request form. See ../docs/yandex-suggest-setup.md for how to obtain both
# keys. Both are optional: without them the address field is a plain text
# input, no autocomplete, no coordinates -- the form still works.

# API Геосаджеста key -- powers the suggest-as-you-type dropdown (custom UI,
# not Yandex's widget). Free tier: 1000 requests/day.
VITE_YANDEX_GEOSUGGEST_API_KEY=

# HTTP Geocoder key -- separate product/key. Used to resolve a picked
# suggestion to coordinates (best-effort; a picked suggestion without this
# key still saves as address text with no lat/lon).
VITE_YANDEX_GEOCODER_API_KEY=
